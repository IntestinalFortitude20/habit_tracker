# Environment variables
DATABASE_URL=sqlite:///./habit_tracker.db

# AI chat (backend only - never expose this key to the frontend)
# Default setup: local Ollama via its OpenAI-compatible API.
# LLM_API_KEY is just a placeholder for local Ollama (any non-empty value works).
LLM_API_KEY=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=llama3.2:3b

# To use OpenAI instead:
# LLM_API_KEY=your-real-api-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
