# Environment variables
DATABASE_URL=sqlite:///./habit_tracker.db

# AI chat (backend only - never expose this key to the frontend)
# Any OpenAI-compatible chat completions provider works.
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
# Optional: override for other OpenAI-compatible providers (e.g. a local server)
# LLM_BASE_URL=https://api.openai.com/v1
